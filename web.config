<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="ZavaBankDb" connectionString="Server=sqlserver,1433;Database=ZavaBankDB;User Id=sa;Password=Zava123!;TrustServerCertificate=true;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <httpHandlers>
      <add verb="GET" path="health" type="ZavaAlertService.HealthHandler" />
    </httpHandlers>
  </system.web>
  <location path="health">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.serviceModel>
    <services>
      <service name="ZavaAlertService.AlertService" behaviorConfiguration="AlertServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" contract="ZavaAlertService.IAlertService" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="AlertServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <handlers>
      <add name="HealthHandler" path="health" verb="GET" type="ZavaAlertService.HealthHandler" resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>
